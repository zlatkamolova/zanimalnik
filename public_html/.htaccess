DirectoryIndex index.php
Options -Indexes

# Only the front controller may run as PHP. Anything else ending in .php (e.g. smuggled into
# uploads/) is refused, and so are dotfiles such as .env or the FTP deploy state file.
<FilesMatch "\.(php\d?|phtml|phar|pht)$">
    Require all denied
</FilesMatch>
<Files "index.php">
    Require all granted
</Files>
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never serve dotfiles (.env, .git, ...) even if one ends up here by mistake
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # Strip a repeated front controller from the URL
    RewriteCond %{REQUEST_URI}::$0 ^(/.+)/(.*)::\2$
    RewriteRule .* - [E=BASE:%1]
    RewriteCond %{HTTP:Authorization} .+
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%0]
    RewriteCond %{ENV:REDIRECT_STATUS} =""
    RewriteRule ^index\.php(?:/(.*)|$) %{ENV:BASE}/$1 [R=301,L]

    # Existing files (assets, uploads) are served directly
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Everything else goes to Symfony
    RewriteRule ^ %{ENV:BASE}/index.php [L]
</IfModule>

<IfModule mod_headers.c>
    # Fingerprinted assets (app-1mMrjBt.css …) never change: cache for a year.
    <FilesMatch "-[A-Za-z0-9_~]{7}\.(css|js|woff2|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # Uploads keep their name when replaced in place — cache for a day only.
    <FilesMatch "\.(png|jpe?g|webp|pdf)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
