{#
    A path drawn as a wax seal: irregular wax edge in the path colour, a pressed inner ring
    and the path symbol embossed in the middle. The symbol colour is chosen for contrast,
    so any colour the admin picks stays readable.
#}
{% props path, size = 56, decorative = true %}
{% set symbols = {
    eye: '<path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
    quill: '<path d="M20 3C12 4 7.5 9 6 17l-2 4"/><path d="M6.5 15c5 0 9.5-3.5 10.5-9"/><path d="M9 11.5h5"/>',
    moon: '<path d="M19.5 14.5A8 8 0 0 1 9.5 4.5a8 8 0 1 0 10 10z"/>',
    spiral: '<path d="M12 12.2a1.2 1.2 0 1 1 1.4 1.2 2.8 2.8 0 0 1-3.3-2.5 4.2 4.2 0 0 1 4.1-4.6 5.8 5.8 0 0 1 5.8 5.6 7.6 7.6 0 0 1-7.4 7.8A9.4 9.4 0 0 1 3 11"/>',
    key: '<circle cx="8" cy="15" r="4"/><path d="M11 12l9-9M17 6l2.5 2.5M14.5 8.5 16.5 10.5"/>',
    compass: '<circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2.2 4.8-4.8 2.2 2.2-4.8z"/>',
    star: '<path d="m12 3 2.6 5.6 6.1.7-4.5 4.2 1.2 6L12 16.6l-5.4 2.9 1.2-6-4.5-4.2 6.1-.7z"/>',
    leaf: '<path d="M5 19C5 10 11 5 20 4c-.5 9-6 15-15 15z"/><path d="M5 19l8-8"/>',
    flame: '<path d="M12 21c3.9 0 7-2.9 7-6.8C19 9 14 7.5 14 3c-3 2-4.5 4.8-4.3 7.6C8.7 9.8 8 8.6 8 7c-2 1.8-3 4.5-3 7.2C5 18.1 8.1 21 12 21z"/>',
    wave: '<path d="M2 9.5c2.5 0 2.5-3 5-3s2.5 3 5 3 2.5-3 5-3 2.5 3 5 3M2 16.5c2.5 0 2.5-3 5-3s2.5 3 5 3 2.5-3 5-3 2.5 3 5 3"/>',
} %}
{% set ink = path.color|text_on %}
{% set gid = 'seal-' ~ path.slug ~ '-' ~ size %}
<svg class="seal {{ attributes.render('class') }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 64 64"
     {% if decorative %}aria-hidden="true" focusable="false"{% else %}role="img" aria-label="Печат на пътека {{ path.name }}"{% endif %}>
    <defs>
        <radialGradient id="{{ gid }}" cx="38%" cy="32%" r="75%">
            <stop offset="0" stop-color="#fff" stop-opacity=".38"/>
            <stop offset=".45" stop-color="#fff" stop-opacity="0"/>
            <stop offset="1" stop-color="#000" stop-opacity=".32"/>
        </radialGradient>
    </defs>
    <path d="M62.0 32.0 L63.6 34.1 L63.3 36.1 L61.4 37.8 L59.2 39.3 L58.2 40.9 L58.5 43.0 L58.9 45.3 L58.0 47.0 L55.9 48.0 L53.8 48.7 L52.7 50.1 L52.3 52.3 L51.8 54.5 L50.2 55.8 L48.0 55.9 L45.9 56.0 L44.5 57.3 L43.5 59.8 L42.2 62.0 L40.2 62.5 L37.8 61.4 L35.7 59.9 L33.8 59.8 L32.0 61.0 L30.0 62.3 L28.0 62.2 L26.3 60.5 L24.9 58.7 L23.2 57.9 L21.1 58.3 L18.9 58.6 L17.2 57.7 L16.1 55.7 L15.2 53.9 L13.5 53.1 L10.8 53.2 L8.3 52.8 L7.1 51.1 L7.2 48.6 L7.6 46.1 L6.9 44.4 L4.9 43.2 L2.8 41.9 L2.2 40.0 L3.2 37.7 L4.5 35.6 L4.7 33.8 L3.6 32.0 L2.5 30.1 L2.7 28.1 L4.1 26.4 L5.4 24.9 L5.5 23.0 L4.6 20.6 L4.0 18.2 L5.0 16.4 L7.4 15.6 L9.7 14.9 L10.8 13.4 L11.0 11.0 L11.4 8.6 L13.0 7.2 L15.5 7.4 L18.1 7.9 L19.9 7.4 L21.1 5.8 L22.5 4.0 L24.3 3.4 L26.4 4.1 L28.4 4.8 L30.2 4.3 L32.0 2.6 L34.0 1.3 L36.0 1.5 L37.7 3.2 L39.3 4.9 L41.1 5.3 L43.4 4.4 L45.9 3.8 L47.7 4.7 L48.6 7.2 L49.1 9.8 L50.1 11.3 L52.1 11.9 L54.3 12.4 L55.6 13.9 L55.8 16.1 L55.8 18.3 L56.8 19.8 L58.8 20.9 L60.8 22.2 L61.3 24.1 L60.5 26.3 L59.7 28.4 L60.2 30.2Z"
          fill="{{ path.color }}"/>
    <path d="M62.0 32.0 L63.6 34.1 L63.3 36.1 L61.4 37.8 L59.2 39.3 L58.2 40.9 L58.5 43.0 L58.9 45.3 L58.0 47.0 L55.9 48.0 L53.8 48.7 L52.7 50.1 L52.3 52.3 L51.8 54.5 L50.2 55.8 L48.0 55.9 L45.9 56.0 L44.5 57.3 L43.5 59.8 L42.2 62.0 L40.2 62.5 L37.8 61.4 L35.7 59.9 L33.8 59.8 L32.0 61.0 L30.0 62.3 L28.0 62.2 L26.3 60.5 L24.9 58.7 L23.2 57.9 L21.1 58.3 L18.9 58.6 L17.2 57.7 L16.1 55.7 L15.2 53.9 L13.5 53.1 L10.8 53.2 L8.3 52.8 L7.1 51.1 L7.2 48.6 L7.6 46.1 L6.9 44.4 L4.9 43.2 L2.8 41.9 L2.2 40.0 L3.2 37.7 L4.5 35.6 L4.7 33.8 L3.6 32.0 L2.5 30.1 L2.7 28.1 L4.1 26.4 L5.4 24.9 L5.5 23.0 L4.6 20.6 L4.0 18.2 L5.0 16.4 L7.4 15.6 L9.7 14.9 L10.8 13.4 L11.0 11.0 L11.4 8.6 L13.0 7.2 L15.5 7.4 L18.1 7.9 L19.9 7.4 L21.1 5.8 L22.5 4.0 L24.3 3.4 L26.4 4.1 L28.4 4.8 L30.2 4.3 L32.0 2.6 L34.0 1.3 L36.0 1.5 L37.7 3.2 L39.3 4.9 L41.1 5.3 L43.4 4.4 L45.9 3.8 L47.7 4.7 L48.6 7.2 L49.1 9.8 L50.1 11.3 L52.1 11.9 L54.3 12.4 L55.6 13.9 L55.8 16.1 L55.8 18.3 L56.8 19.8 L58.8 20.9 L60.8 22.2 L61.3 24.1 L60.5 26.3 L59.7 28.4 L60.2 30.2Z"
          fill="url(#{{ gid }})"/>
    {# pressed ring: dark groove + light lip #}
    <circle cx="32" cy="32" r="21.5" fill="none" stroke="#000" stroke-opacity=".28" stroke-width="2"/>
    <circle cx="32.6" cy="32.6" r="21.5" fill="none" stroke="#fff" stroke-opacity=".22" stroke-width="1"/>
    <g transform="translate(18 18) scale(1.1667)" fill="none" stroke="{{ ink }}" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        {{ (symbols[path.symbol] ?? '<circle cx="12" cy="12" r="4"/>')|raw }}
    </g>
</svg>
