{# A path drawn as a wax seal: coloured disc, double ring, symbol in the middle. #}
{% props path, size = 56, decorative = true %}
{% set symbols = {
    eye: '<path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
    quill: '<path d="M20 3C12 4 7.5 9 6 17l-2 4"/><path d="M6.5 15c5 0 9.5-3.5 10.5-9"/><path d="M9 11.5h5"/>',
    moon: '<path d="M19.5 14.5A8 8 0 0 1 9.5 4.5a8 8 0 1 0 10 10z"/>',
    spiral: '<path d="M12 12.2a1.2 1.2 0 1 1 1.4 1.2 2.8 2.8 0 0 1-3.3-2.5 4.2 4.2 0 0 1 4.1-4.6 5.8 5.8 0 0 1 5.8 5.6 7.6 7.6 0 0 1-7.4 7.8A9.4 9.4 0 0 1 3 11"/>',
    key: '<circle cx="8" cy="15" r="4"/><path d="M11 12l9-9M17 6l2.5 2.5M14.5 8.5 16.5 10.5"/>',
    compass: '<circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2.2 4.8-4.8 2.2 2.2-4.8z"/>',
    star: '<path d="m12 3 2.6 5.6 6.1.7-4.5 4.2 1.2 6L12 16.6l-5.4 2.9 1.2-6-4.5-4.2 6.1-.7z"/>',
    leaf: '<path d="M5 19C5 10 11 5 20 4c-.5 9-6 15-15 15z"/><path d="M5 19l8-8"/>',
    flame: '<path d="M12 21c3.9 0 7-2.9 7-6.8C19 9 14 7.5 14 3c-3 2-4.5 4.8-4.3 7.6C8.7 9.8 8 8.6 8 7c-2 1.8-3 4.5-3 7.2C5 18.1 8.1 21 12 21z"/>',
    wave: '<path d="M2 9.5c2.5 0 2.5-3 5-3s2.5 3 5 3 2.5-3 5-3 2.5 3 5 3M2 16.5c2.5 0 2.5-3 5-3s2.5 3 5 3 2.5-3 5-3 2.5 3 5 3"/>',
} %}
<span class="seal {{ attributes.render('class') }}" style="--seal: {{ path.color }}; width: {{ size }}px; height: {{ size }}px"
      {% if decorative %}aria-hidden="true"{% else %}role="img" aria-label="Печат на пътека {{ path.name }}"{% endif %}>
    <svg viewBox="0 0 24 24" width="{{ (size * 0.5)|round }}" height="{{ (size * 0.5)|round }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        {{ (symbols[path.symbol] ?? '<circle cx="12" cy="12" r="4"/>')|raw }}
    </svg>
</span>
