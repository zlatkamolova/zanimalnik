{# EasyAdmin's login page plus the site's CSRF double-submit script.
   Symfony remembers per session that the double-submit was used (e.g. on /vhod) and from then on
   refuses forms that come without it — so this page must send it too. #}
{% extends '@EasyAdmin/page/login.html.twig' %}

{% block head_javascript %}
    {{ parent() }}
    {{ importmap('csrf') }}
{% endblock %}

{% block login_form_footer %}
    <p class="text-center mt-3 mb-0">
        <a href="{{ path('app_forgot_password') }}">Забравена парола?</a>
    </p>
{% endblock %}
