{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Добре дошли в Занималника{% endblock %}

{% block main %}
    <p>
        Публикувани куестове: <strong>{{ published_count }}</strong>
        · Чернови: <strong>{{ draft_count }}</strong>
    </p>

    <h2>Предизвикателства за днес, {{ today|date('d.m.Y') }}</h2>
    {% if today_challenges is empty %}
        <p>Няма публикувани куестове, отбелязани като „Може да бъде предизвикателство на деня“.</p>
    {% else %}
        <ul>
            {% for challenge in today_challenges %}
                <li><strong>{{ challenge.path.name }}:</strong> {{ challenge.quest.title }}</li>
            {% endfor %}
        </ul>
    {% endif %}

    <p>
        <a href="{{ path('admin_quest_new') }}">Нов куест</a>
        · <a href="{{ path('admin_daily_challenges_index') }}">Следващите 7 дни</a>
    </p>
{% endblock %}
