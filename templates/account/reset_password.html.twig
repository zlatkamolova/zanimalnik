{% extends 'base.html.twig' %}
{% import '_form.html.twig' as f %}

{% block title %}Нова парола{% endblock %}
{% block robots %}<meta name="robots" content="noindex">{% endblock %}
{% block canonical %}{{ url('app_forgot_password') }}{% endblock %}

{% block body %}
    <section class="mx-auto max-w-md px-4 py-12">
        <h1 class="page-title text-center">Нова парола</h1>

        {% if form %}
            {{ form_start(form, {attr: {class: 'form-card'}}) }}
                {{ f.row(form.plainPassword, 'Поне 8 знака.') }}
                <button type="submit" class="btn">Запази паролата</button>
            {{ form_end(form) }}
        {% else %}
            <p class="form-error" role="alert">Връзката е невалидна или е изтекла.</p>
            <p class="form-links"><a href="{{ path('app_forgot_password') }}">Поискай нова връзка</a></p>
        {% endif %}
    </section>
{% endblock %}
