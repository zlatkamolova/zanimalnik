{% extends 'base.html.twig' %}
{% import '_form.html.twig' as f %}

{% block title %}Забравена парола{% endblock %}
{% block description %}Забравена парола за Занималника: напиши имейла си и ще получиш връзка за нова парола.{% endblock %}
{% block robots %}<meta name="robots" content="noindex">{% endblock %}

{% block body %}
    <section class="mx-auto max-w-md px-4 py-12">
        <h1 class="page-title text-center">Забравена парола</h1>

        {% if sent %}
            <p class="flash" role="status">Ако има профил с този имейл, изпратихме му връзка за нова парола. Валидна е един час.</p>
            <p class="form-links"><a href="{{ path('app_user_login') }}">Към входа</a></p>
        {% else %}
            <p class="page-lead text-center">Напиши имейла, с който е профилът ти. Ще получиш връзка за нова парола.</p>
            {{ form_start(form, {attr: {class: 'form-card'}}) }}
                {{ f.row(form.email) }}
                <button type="submit" class="btn">Изпрати връзка</button>
            {{ form_end(form) }}
            <p class="form-links"><a href="{{ path('app_user_login') }}">Обратно към входа</a></p>
        {% endif %}
    </section>
{% endblock %}
