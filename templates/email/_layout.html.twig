{#
  Shared look of every e-mail: a paper card on parchment, like the site.
  Mail programs ignore stylesheets and web fonts, so: tables, inline styles, system fonts, no images.
  Blocks: title (also the hidden preview line), content, button_url + button_label, note.
#}
<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
    <title>{% block title %}Занималник{% endblock %}</title>
</head>
<body style="margin:0; padding:0; background-color:#f3e9d2;">
<div style="display:none; max-height:0; overflow:hidden; opacity:0; color:#f3e9d2;">{% block preview %}{{ block('title') }}{% endblock %}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f3e9d2;">
    <tr>
        <td align="center" style="padding:32px 16px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;">
                <tr>
                    <td align="center" style="padding:0 0 20px; font-family:Georgia, 'Times New Roman', serif; font-size:26px; font-weight:bold; letter-spacing:.5px;">
                        <a href="{{ url('app_home') }}" style="color:#2b2118; text-decoration:none;">Занималник</a>
                    </td>
                </tr>
                <tr>
                    <td style="background-color:#f8f1e0; border:1px solid #b89f74; border-top:4px solid #8a3b12; border-radius:6px; padding:32px 28px; font-family:Arial, Helvetica, sans-serif; font-size:16px; line-height:1.6; color:#2b2118;">
                        <h1 style="margin:0 0 16px; font-family:Georgia, 'Times New Roman', serif; font-size:24px; line-height:1.3; font-weight:bold; color:#2b2118;">{{ block('title') }}</h1>

                        {% block content %}{% endblock %}

                        {% if block('button_url') is defined %}
                            <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0;">
                                <tr>
                                    <td align="center" bgcolor="#8a3b12" style="background-color:#8a3b12; border-radius:6px;">
                                        <a href="{{ block('button_url') }}" style="display:inline-block; padding:13px 26px; font-family:Arial, Helvetica, sans-serif; font-size:16px; font-weight:bold; color:#ffffff; text-decoration:none;">{{ block('button_label') }}</a>
                                    </td>
                                </tr>
                            </table>
                            <p style="margin:0 0 6px; font-size:14px; color:#5a4a3a;">Ако бутонът не работи, копирай този адрес в браузъра:</p>
                            <p style="margin:0; font-size:14px; word-break:break-all;"><a href="{{ block('button_url') }}" style="color:#8a3b12;">{{ block('button_url') }}</a></p>
                        {% endif %}

                        {% if block('note') is defined %}
                            <p style="margin:24px 0 0; padding-top:16px; border-top:1px solid #e7d8b6; font-size:14px; color:#5a4a3a;">{{ block('note') }}</p>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <td align="center" style="padding:20px 8px 0; font-family:Arial, Helvetica, sans-serif; font-size:13px; line-height:1.5; color:#5a4a3a;">
                        Това писмо е изпратено автоматично — моля, не отговаряй на него.<br>
                        <a href="{{ url('app_home') }}" style="color:#5a4a3a;">zanimalnik.com</a>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
